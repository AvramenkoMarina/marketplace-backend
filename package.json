{
  "name": "marketplace-api",
  "version": "1.1.0",
  "description": "Marketplace API \u2014 OpenAPI contract, Nest config, rotatable DB secrets (HW-09 + HW-11)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint:openapi": "npx @redocly/cli@2.46.0 lint openapi/openapi.yaml",
    "bundle:openapi": "npx @redocly/cli@2.46.0 bundle openapi/openapi.yaml -o spec.json",
    "check:spec": "npm run lint:openapi && npm run bundle:openapi && node scripts/check-spec.cjs",
    "check:env": "node scripts/check-env-example.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "dotenv": "^8.2.0",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@redocly/cli": "2.46.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "typescript": "^5.7.3"
  }
}
