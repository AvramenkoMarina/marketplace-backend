{
  "name": "marketplace-api",
  "version": "1.1.0",
  "description": "Marketplace API — TypeORM entities, migrations, and reports (HW-13)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "migrate": "bash scripts/with-secrets.sh dev npx typeorm migration:run -d dist/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev npx typeorm migration:show -d dist/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev npx typeorm migration:revert -d dist/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo-nplus1.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo-retry.js",
    "lint:openapi": "npx @redocly/cli@2.46.0 lint openapi/openapi.yaml",
    "bundle:openapi": "npx @redocly/cli@2.46.0 bundle openapi/openapi.yaml -o spec.json",
    "check:spec": "npm run lint:openapi && npm run bundle:openapi && node scripts/check-spec.cjs",
    "check:env": "node scripts/check-env-example.mjs",
    "test:integration": "jest --config jest.config.js --testPathPatterns test/integration --runInBand",
    "test:e2e": "jest --config jest.config.js --testPathPatterns test/e2e --runInBand",
    "test:contract": "PACT_DO_NOT_TRACK=true jest --config jest.config.js --testPathPatterns test/contract/consumer --runInBand",
    "verify:provider": "PACT_DO_NOT_TRACK=true jest --config jest.config.js --testPathPatterns test/contract/provider --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@nestjs/testing": "^11.2.7",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.3"
  }
}
