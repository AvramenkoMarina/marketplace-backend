# Application
# NODE_ENV: development | test | production
NODE_ENV=development

# HTTP port (z.coerce.number)
PORT=3000

# Postgres URL WITHOUT password — password comes from DB_PASSWORD_FILE
# Example: postgresql://USER@HOST:PORT/DB
DB_URL=postgresql://marketplace@localhost:6432/marketplace

# Path to password file-secret (rotated without process restart)
DB_PASSWORD_FILE=./secrets/db_password

# AMQP URL including user and password. The real value lives in the secret store.
# Compose dev stand uses user app, password app, port 5672 (AMQP, not 15672).
BROKER_URL=amqp://USER:PASSWORD@127.0.0.1:5672
