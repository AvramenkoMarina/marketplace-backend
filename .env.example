# Application
# NODE_ENV: development | test | production
NODE_ENV=development

# HTTP port (z.coerce.number)
PORT=3000

# Postgres URL WITHOUT password — password comes from DB_PASSWORD_FILE
# Example: postgresql://USER@HOST:PORT/DB
DB_URL=postgresql://marketplace@localhost:5433/marketplace

# Path to password file-secret (rotated without process restart)
DB_PASSWORD_FILE=./secrets/db_password
