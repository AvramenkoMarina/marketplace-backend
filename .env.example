# Application
# NODE_ENV: development | test | production
NODE_ENV=development

# HTTP port (z.coerce.number)
PORT=3000

# Postgres URL WITHOUT password — password comes from DB_PASSWORD_FILE
# Example: postgresql://USER@HOST:PORT/DB
DB_URL=postgresql://marketplace@localhost:6432/marketplace

# Path to password file-secret (rotated without process restart)
DB_PASSWORD_FILE=./secrets/db_password

# AMQP URL including user and password. The real value lives in the secret store.
# Compose dev stand uses user app, password app, port 5672 (AMQP, not 15672).
BROKER_URL=amqp://USER:PASSWORD@127.0.0.1:5672

# Cache Redis (allkeys-lru, maxmemory > 0). Not the queue instance.
REDIS_URL=redis://127.0.0.1:16379

# Queue Redis (noeviction). Sessions and the rate-limit counter live here too:
# the cache instance may evict them under allkeys-lru.
REDIS_QUEUE_URL=redis://127.0.0.1:16380

# ES256 signing key id. No default: dev and prod must differ.
JWT_KID=

# ES256 PKCS8 private key, PEM encoded as a single base64 line. No default.
JWT_PRIVATE_KEY=

# ES256 SPKI public key, PEM encoded as a single base64 line. No default.
JWT_PUBLIC_KEY=

# Previous kid kept only during signing-key overlap. Empty unless rotating.
JWT_PREVIOUS_KID=

# Previous ES256 SPKI public key, base64 PEM. Empty unless rotating.
JWT_PREVIOUS_PUBLIC_KEY=

# HMAC pepper for refresh-token hashes. No default.
REFRESH_TOKEN_PEPPER=
